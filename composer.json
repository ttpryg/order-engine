{
    "name": "ttpryg/order-engine",
    "description": "Framework-agnostic PHP Order Engine library for order lifecycle, snapshots, calculations, address management, and order history.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Toto",
            "email": "totoprayogo1916@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ttpryg/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ttpryg\\OrderEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ttpryg\\OrderEngine\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "analyse": "vendor/bin/phpstan analyse",
        "check": [
            "@test",
            "@fix:check",
            "@analyse"
        ],
        "fix:check": [
            "vendor/bin/rector process --dry-run",
            "vendor/bin/pint --test"
        ],
        "fix": [
            "vendor/bin/rector process",
            "vendor/bin/pint"
        ]
    }
}
